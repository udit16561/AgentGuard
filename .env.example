NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
SESSION_SECRET=change-me
TOKEN_ENCRYPTION_KEY=32-byte-base64-key-here
INTEGRATION_MODE=mock
APPROVAL_TTL_MINUTES=10
REAUTH_WINDOW_MINUTES=5
CORS_ORIGIN=http://localhost:5173
# Optional intent model layer
INTENT_MODEL_PROVIDER=none
INTENT_MODEL_API_KEY=
# Optional tool-preference parser (falls back to the built-in parser on any error or after 3 s)
PREFERENCE_MODEL_PROVIDER=none
PREFERENCE_MODEL=claude-haiku-5-5
PREFERENCE_MODEL_API_KEY=
# Bring your own model: users add their own keys under Settings → Models (stored encrypted with TOKEN_ENCRYPTION_KEY).
# Phone alerts (Web Push). npm run dev:lan generates these into backend/.env; or: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# MODEL_PROVIDER_MODE=fake swaps in local fake models, and only when NODE_ENV=test (browser tests).
# Live Google Calendar (v0.8.0): needs INTEGRATION_MODE=live AND Calendar switched to LIVE on the Tools screen. Everything else stays MOCK.
# Google Cloud console: OAuth client (Web application), scope calendar.events, redirect URI below. Open the app at https://localhost:4443 (npm run dev:lan).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:4443/api/oauth/google/callback
# true while the Google app is unpublished (Testing): refresh tokens expire after 7 days, so the app asks to reconnect
GOOGLE_OAUTH_TESTING=true
# GOOGLE_OAUTH_MODE=fake swaps in a pretend Google, and only when NODE_ENV=test (browser tests).
