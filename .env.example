NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
SESSION_SECRET=change-me
TOKEN_ENCRYPTION_KEY=32-byte-base64-key-here
INTEGRATION_MODE=mock
APPROVAL_TTL_MINUTES=10
REAUTH_WINDOW_MINUTES=5
CORS_ORIGIN=http://localhost:5173
# Optional intent model layer
INTENT_MODEL_PROVIDER=none
INTENT_MODEL_API_KEY=
# Optional tool-preference parser (falls back to the built-in parser on any error or after 3 s)
PREFERENCE_MODEL_PROVIDER=none
PREFERENCE_MODEL=claude-haiku-5-5
PREFERENCE_MODEL_API_KEY=
# Bring your own model: users add their own keys under Settings → Models (stored encrypted with TOKEN_ENCRYPTION_KEY).
# MODEL_PROVIDER_MODE=fake swaps in local fake models, and only when NODE_ENV=test (browser tests).
