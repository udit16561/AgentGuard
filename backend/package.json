{
  "name": "agentguard-backend",
  "version": "1.0.0",
  "description": "AgentGuard API (prototype)",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:lan": "tsx src/dev/lan.ts",
    "live:check:calendar": "tsx src/dev/live-check-calendar.ts",
    "build": "tsc -p .",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:intent": "vitest run tests/intent",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src tests",
    "db:migrate": "tsx src/db/migrate.ts",
    "demo:agent": "tsx ../examples/demo-agent.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/groq": "4.0.70",
    "@ai-sdk/mistral": "4.0.72",
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@anthropic-ai/sdk": "^1.3.0",
    "ai": "7.0.153",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "undici": "8.12.3",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@peculiar/x509": "2.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "eslint": "^10.13.0",
    "reflect-metadata": "0.2.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
